: "${LAB_PREFIX:=kamaji-cnpg-tenants}"
: "${OWNERSHIP_LABEL:=io.cnpg-vcluster.kamaji-lab}"
: "${KIND_CLUSTER_NAME:=kamaji-cnpg-management}"
: "${MANAGEMENT_NAMESPACE:=kamaji-system}"
: "${TENANT_NAMES:=tenant-a tenant-b}"
: "${TENANT_NAMESPACE_PREFIX:=kamaji}"
: "${WORKERS_PER_TENANT:=3}"
: "${TENANT_A_SCHEMA:=kamaji-tenant-a}"
: "${TENANT_B_SCHEMA:=kamaji-tenant-b}"
: "${TENANT_A_NAMESPACE:=kamaji-tenant-a}"
: "${TENANT_B_NAMESPACE:=kamaji-tenant-b}"
: "${TENANT_A_DATASTORE_USER:=kamaji-tenant-a}"
: "${TENANT_B_DATASTORE_USER:=kamaji-tenant-b}"

: "${MANAGEMENT_POD_CIDR:=10.200.0.0/16}"
: "${MANAGEMENT_SERVICE_CIDR:=10.201.0.0/16}"
: "${TENANT_A_POD_CIDR:=10.64.0.0/16}"
: "${TENANT_A_SERVICE_CIDR:=10.128.0.0/16}"
: "${TENANT_A_DNS_SERVICE_IP:=10.128.0.10}"
: "${TENANT_A_CLUSTER_DOMAIN:=tenant-a.cluster.local}"
: "${TENANT_A_CERT_DNS:=api.tenant-a.kamaji.local}"
: "${TENANT_B_POD_CIDR:=10.65.0.0/16}"
: "${TENANT_B_SERVICE_CIDR:=10.129.0.0/16}"
: "${TENANT_B_DNS_SERVICE_IP:=10.129.0.10}"
: "${TENANT_B_CLUSTER_DOMAIN:=tenant-b.cluster.local}"
: "${TENANT_B_CERT_DNS:=api.tenant-b.kamaji.local}"
: "${TENANT_STORAGE_CLASS:=local-path}"
: "${TENANT_A_STORAGE_PATH:=/var/lib/kamaji-local-path/tenant-a}"
: "${TENANT_B_STORAGE_PATH:=/var/lib/kamaji-local-path/tenant-b}"
: "${TENANT_SMOKE_PVC:=kamaji-storage-smoke}"
: "${TENANT_SMOKE_POD:=kamaji-storage-smoke}"
: "${TENANT_NETWORK_SMOKE_POD:=kamaji-network-smoke}"
: "${TENANT_SMOKE_MARKER:=kamaji-storage}"
: "${CNPG_NAMESPACE:=cnpg-system}"
: "${DATABASE_NAMESPACE:=database}"
: "${CNPG_INSTANCE_COUNT:=3}"
: "${CNPG_STORAGE_SIZE:=1Gi}"
: "${TENANT_A_CNPG_CLUSTER:=tenant-a-postgres}"
: "${TENANT_B_CNPG_CLUSTER:=tenant-b-postgres}"
: "${TENANT_A_DATABASE:=tenant_a}"
: "${TENANT_B_DATABASE:=tenant_b}"
: "${TENANT_A_DATABASE_OWNER:=tenant_a_owner}"
: "${TENANT_B_DATABASE_OWNER:=tenant_b_owner}"
: "${TENANT_A_DATABASE_MARKER:=kamaji-tenant-a-marker}"
: "${TENANT_B_DATABASE_MARKER:=kamaji-tenant-b-marker}"
: "${CNPG_REQUEST_CPU:=100m}"
: "${CNPG_REQUEST_MEMORY:=256Mi}"
: "${CNPG_LIMIT_CPU:=1}"
: "${CNPG_LIMIT_MEMORY:=1Gi}"
: "${SQL_CLIENT_REQUEST_CPU:=25m}"
: "${SQL_CLIENT_REQUEST_MEMORY:=32Mi}"
: "${SQL_CLIENT_LIMIT_CPU:=100m}"
: "${SQL_CLIENT_LIMIT_MEMORY:=128Mi}"
: "${KUBE_PROXY_CONNTRACK_MAX_PER_CORE:=0}"
: "${KUBE_PROXY_RECONCILE_PROOF_SECONDS:=10}"
: "${COMPATIBILITY_REVISION:=kube-proxy-conntrack-zero-v2}"
: "${SPIKE_NAME:=kamaji-worker-spike}"
: "${SPIKE_NAMESPACE:=kamaji-spike-system}"
: "${SPIKE_SCHEMA:=kamaji-worker-spike}"
: "${SPIKE_DATASTORE_USER:=kamaji-worker-spike}"
: "${SPIKE_POD_CIDR:=10.66.0.0/16}"
: "${SPIKE_SERVICE_CIDR:=10.130.0.0/16}"
: "${SPIKE_DNS_SERVICE_IP:=10.130.0.10}"
: "${SPIKE_CLUSTER_DOMAIN:=spike.cluster.local}"
: "${SPIKE_WORKER_NAME:=kamaji-worker-spike-node}"
: "${SPIKE_VOLUME_NAME:=kamaji-worker-spike-var-lib}"
: "${SPIKE_STORAGE_CLASS:=local-path}"
: "${SPIKE_STORAGE_PATH:=/var/lib/kamaji-local-path}"
: "${SPIKE_SMOKE_PVC:=spike-storage-smoke}"
: "${SPIKE_SMOKE_POD:=spike-storage-smoke}"
: "${SPIKE_PERSISTENCE_MARKER:=kamaji-spike-persistent-value}"

# Host admission floors. Environment overrides are intentional test/operator
# inputs for stricter admission or deterministic failure fixtures.
: "${MIN_DOCKER_CPUS:=12}"
: "${MIN_DOCKER_MEMORY_GIB:=24}"
: "${MIN_DOCKER_STORAGE_GIB:=30}"
# The management node and six nested workers share the host-root inotify
# accounting pool. The observed 128-instance default is exhausted during
# systemd startup; 1024 instances is proven sufficient for this topology.
# 524288 watches is the standard multi-node kind floor and prevents the paired
# watch limit from becoming the next host bottleneck.
: "${MIN_INOTIFY_INSTANCES:=1024}"
: "${MIN_INOTIFY_WATCHES:=524288}"

# Concrete host-visible and management request budget.
: "${WORKER_CPUS:=1.25}"
: "${WORKER_MEMORY_MIB:=2560}"
: "${WORKER_TOTAL_CPUS:=7.5}"
: "${WORKER_TOTAL_MEMORY_GIB:=15}"
: "${KIND_RESERVE_CPUS:=2}"
: "${KIND_RESERVE_MEMORY_GIB:=3}"
: "${MANAGEMENT_REQUEST_CPUS:=1.21}"
: "${MANAGEMENT_REQUEST_MEMORY_GIB:=2.28125}"
: "${KAMAJI_CONTROLLER_REQUEST_CPU:=100m}"
: "${KAMAJI_CONTROLLER_REQUEST_MEMORY:=128Mi}"
: "${KAMAJI_CONTROLLER_LIMIT_CPU:=500m}"
: "${KAMAJI_CONTROLLER_LIMIT_MEMORY:=512Mi}"
: "${KAMAJI_ETCD_REPLICAS:=3}"
: "${KAMAJI_ETCD_REQUEST_CPU:=100m}"
: "${KAMAJI_ETCD_REQUEST_MEMORY:=256Mi}"
: "${KAMAJI_ETCD_LIMIT_CPU:=500m}"
: "${KAMAJI_ETCD_LIMIT_MEMORY:=512Mi}"
: "${KAMAJI_ETCD_PVC_SIZE:=1Gi}"
: "${ETCD_INSPECTOR_REQUEST_CPU:=10m}"
: "${ETCD_INSPECTOR_REQUEST_MEMORY:=32Mi}"
: "${ETCD_INSPECTOR_LIMIT_CPU:=100m}"
: "${ETCD_INSPECTOR_LIMIT_MEMORY:=64Mi}"
: "${TENANT_CONTROL_PLANE_REPLICAS:=1}"
: "${TENANT_CONTROL_PLANE_REQUEST_CPU:=250m}"
: "${TENANT_CONTROL_PLANE_REQUEST_MEMORY:=512Mi}"
: "${TENANT_CONTROL_PLANE_LIMIT_CPU:=1}"
: "${TENANT_CONTROL_PLANE_LIMIT_MEMORY:=1536Mi}"
# Per-container split whose three rendered control-plane components sum to the
# aggregate request and limit above. The API server keeps its measured request
# while using a 1Gi cgroup ceiling; 512Mi produced repeatable OOMKills during
# the complete two-tenant CNPG lifecycle on a host with ample free memory.
: "${TENANT_API_SERVER_REQUEST_CPU:=125m}"
: "${TENANT_API_SERVER_REQUEST_MEMORY:=256Mi}"
: "${TENANT_API_SERVER_LIMIT_CPU:=500m}"
: "${TENANT_API_SERVER_LIMIT_MEMORY:=1Gi}"
: "${TENANT_CONTROLLER_MANAGER_REQUEST_CPU:=75m}"
: "${TENANT_CONTROLLER_MANAGER_REQUEST_MEMORY:=128Mi}"
: "${TENANT_CONTROLLER_MANAGER_LIMIT_CPU:=300m}"
: "${TENANT_CONTROLLER_MANAGER_LIMIT_MEMORY:=256Mi}"
: "${TENANT_SCHEDULER_REQUEST_CPU:=50m}"
: "${TENANT_SCHEDULER_REQUEST_MEMORY:=128Mi}"
: "${TENANT_SCHEDULER_LIMIT_CPU:=200m}"
: "${TENANT_SCHEDULER_LIMIT_MEMORY:=256Mi}"

# Kubeadm exceptions are empty until a target-version dry run observes an exact
# container-only preflight failure. The executed join and documentation consume
# this single comma-separated setting verbatim.
: "${KUBEADM_IGNORE_PREFLIGHT_ERRORS:=}"
: "${KUBEADM_TOKEN_TTL:=10m}"

# Finite operations.
: "${DOWNLOAD_TIMEOUT:=5m}"
: "${PREFLIGHT_ENDPOINT_TIMEOUT:=2m}"
: "${PREFLIGHT_PROBE_TIMEOUT:=1m}"
: "${KUBECTL_REQUEST_TIMEOUT:=30s}"
: "${KIND_CREATE_TIMEOUT:=5m}"
: "${CERT_MANAGER_TIMEOUT:=5m}"
: "${METALLB_TIMEOUT:=5m}"
: "${KAMAJI_TIMEOUT:=10m}"
: "${DATASTORE_TIMEOUT:=10m}"
: "${TENANT_CONTROL_PLANE_TIMEOUT:=15m}"
: "${WORKER_START_TIMEOUT:=5m}"
: "${SYSTEMD_STATUS_TIMEOUT:=10s}"
: "${WORKER_JOIN_TIMEOUT:=5m}"
: "${WORKER_READY_GRACE_TIMEOUT:=2m}"
: "${TENANT_ADDON_TIMEOUT:=10m}"
: "${TENANT_STORAGE_TIMEOUT:=5m}"
: "${CNPG_TIMEOUT:=15m}"
: "${SQL_CLIENT_TIMEOUT:=5m}"
: "${POD_RESTART_TIMEOUT:=10m}"
: "${FAILOVER_TIMEOUT:=10m}"
: "${SPIKE_DELETE_TIMEOUT:=10m}"
: "${TENANT_DELETE_TIMEOUT:=10m}"
: "${WAIT_POLL_INTERVAL:=5}"

EXIT_SUCCESS=0
EXIT_ERROR=1
EXIT_BLOCKED=2
COMPATIBILITY_BLOCKER_CODES="worker-substrate kubeadm-bootstrap cni-konnectivity persistent-worker-storage"
