{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRole",
  "metadata": {
    "name": "tenant-admin-local"
  },
  "rules": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "namespaces"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "admissionregistration.k8s.io"
      ],
      "resourceNames": [
        "tenant-database-catalog-cutover-create-lock"
      ],
      "resources": [
        "validatingadmissionpolicies",
        "validatingadmissionpolicybindings"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "apps"
      ],
      "resourceNames": [
        "database-controller"
      ],
      "resources": [
        "deployments"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "bootstrap.cluster.x-k8s.io"
      ],
      "resources": [
        "kubeadmconfigs",
        "kubeadmconfigtemplates"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "cluster.x-k8s.io"
      ],
      "resources": [
        "clusters",
        "machinedeployments",
        "machines",
        "machinesets"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "controlplane.cluster.x-k8s.io"
      ],
      "resources": [
        "kamajicontrolplanes"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "infrastructure.cluster.x-k8s.io"
      ],
      "resources": [
        "devclusters",
        "devmachines",
        "devmachinetemplates"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "kamaji.clastix.io"
      ],
      "resources": [
        "tenantcontrolplanes"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "rbac.authorization.k8s.io"
      ],
      "resourceNames": [
        "tenant-database-credentials"
      ],
      "resources": [
        "roles",
        "rolebindings"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "tenancy.cnpg-vcluster.io"
      ],
      "resources": [
        "tenantdatabasecatalogs"
      ],
      "verbs": [
        "get",
        "update"
      ]
    },
    {
      "apiGroups": [
        "tenancy.cnpg-vcluster.io"
      ],
      "resources": [
        "tenants"
      ],
      "verbs": [
        "create",
        "delete",
        "get",
        "list"
      ]
    }
  ]
}
