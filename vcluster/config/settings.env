: "${LAB_PREFIX:=cnpg-private}"
: "${KIND_CLUSTER_NAME:=cnpg-private-control}"
: "${PLATFORM_NAMESPACE:=vcluster-platform}"
: "${PLATFORM_PROJECT:=default}"
: "${TENANT_NAMESPACE_PREFIX:=tenant}"
: "${TENANT_NAMES:=tenant-a tenant-b}"
: "${WORKERS_PER_TENANT:=3}"

: "${MIN_DOCKER_CPUS:=12}"
: "${MIN_DOCKER_MEMORY_GIB:=24}"
: "${MIN_FREE_DISK_GIB:=30}"
: "${WORKER_CPUS:=2}"
: "${WORKER_MEMORY:=3g}"

: "${KIND_TIMEOUT:=5m}"
: "${PLATFORM_TIMEOUT:=10m}"
: "${TENANT_TIMEOUT:=10m}"
: "${WORKER_BOOT_TIMEOUT:=2m}"
: "${WORKER_REACH_TIMEOUT:=2m}"
: "${NODE_TIMEOUT:=15m}"
: "${ADDON_TIMEOUT:=10m}"
: "${PVC_TIMEOUT:=10m}"
: "${NETWORK_VERIFY_TIMEOUT:=2m}"
: "${CNPG_TIMEOUT:=20m}"
: "${POD_RESTART_TIMEOUT:=10m}"
: "${FAILOVER_TIMEOUT:=10m}"
