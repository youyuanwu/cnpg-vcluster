test-controller-readiness:
    @python3 scripts/run_locked.py scripts/test_controller_readiness.py

# Exercise ordinary Tenant deletion, restart recovery, and same-name recreation.
test-controller-deletion:
    @python3 scripts/run_locked.py scripts/test_controller_deletion.py

# Evaluate Tenant status from generation-aware Kubernetes conditions.
controller-tenant-status tenant:
    @python3 scripts/controller_tenant_status.py {{quote(tenant)}}

