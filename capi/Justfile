repair tenant:
    @python3 scripts/lab.py unavailable repair "{{tenant}}"

# [implemented] Report read-only summarized state.
status:
    @python3 scripts/lab.py status

# [implemented] Report read-only scoped diagnostics.
diagnose scope="all":
    @python3 scripts/lab.py diagnose "{{scope}}"

# [phase 8] Verify tenant isolation and database behavior.
verify:
    @python3 scripts/lab.py unavailable verify

# [phase 9] Delete one tenant and verify the survivor.
destroy-tenant tenant:
    @python3 scripts/lab.py unavailable destroy-tenant "{{tenant}}"

# [implemented through phase 2] Delete exactly owned management resources.
destroy:
    @python3 scripts/lab.py destroy

# [phase 10] Remove one exact stuck finalizer after UID confirmation.
break-glass kind namespace name uid:
    @python3 scripts/lab.py unavailable break-glass "{{kind}}" "{{namespace}}" "{{name}}" "{{uid}}"

# [implemented] Run standard-library unit tests.
