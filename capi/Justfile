# Verify checked-in TenantDatabaseCatalog API and RBAC resources.
database-controller-verify:
    @cargo run --locked --offline -p tenant-database-controller --bin generate -- --check

# Run database-controller API and generated-contract tests.
database-controller-test:
    @cargo test --locked --offline -p tenant-database-controller --all-targets

# Lint the isolated database-controller crate.
database-controller-lint:
    @cargo fmt --all --check
    @cargo clippy --locked --offline -p tenant-database-controller --all-targets -- -D warnings

# Build the standalone database-controller observer manager.
database-controller-build:
    @cargo rustc --locked --offline --release -p tenant-database-controller --bin manager -- -C target-feature=+crt-static

# Reconcile pinned database charts separately from Azure infrastructure readiness.
# Supervise this command for continuous retry; --once performs one bounded attempt.
azure-database-runtime-watch:
    @python3 -m scripts.azure_database_runtime --watch

azure-database-runtime-once:
    @python3 -m scripts.azure_database_runtime --once
    @! readelf -lW ../target/release/manager | grep -q ' INTERP '
    @! readelf -dW ../target/release/manager | grep -q ' NEEDED '

