set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# [implemented] Acquire and verify every pinned artifact and OCI image online.
cache:
    @python3 scripts/lab.py cache

# [implemented] Install and verify tools from the complete local cache.
tools:
    @python3 scripts/lab.py tools

# [implemented] Record and raise the local host inotify floors.
prepare-host:
    @python3 scripts/lab.py prepare-host

# [implemented] Validate prepared inputs and the local Docker host.
preflight:
    @python3 scripts/lab.py preflight

# Validate the selected Azure subscription, region, SKUs, image, and Bicep.
azure-preflight:
    @python3 scripts/azure.py preflight

# Create the minimal Azure resource group, network, identity, and AKS cluster.
azure-create-foundation:
    @python3 scripts/azure.py create-foundation

# Install the pinned CAPI, CAPZ, Kamaji, and bootstrap controller stack on AKS.
azure-create-management:
    @python3 scripts/azure.py create-management

# Report only the exact recorded Azure management foundation state.
azure-foundation-status:
    @python3 scripts/azure.py foundation-status

# Start deletion of the exactly recorded Azure experiment resource group.
azure-destroy:
    @python3 scripts/azure.py destroy

# Destructively run the one clean Azure create-delete-recreate lifecycle gate.
azure-test-tenant-lifecycle spec="config/tenants/examples/azure.json":
    @python3 scripts/test_azure_tenant_lifecycle.py {{quote(spec)}}

# Create one tenant from an explicit local or Azure JSON specification.
tenant-create profile spec:
    @python3 scripts/tenant.py create {{quote(profile)}} {{quote(spec)}}

# Report one tenant through the provider-neutral status envelope.
tenant-status profile tenant:
    @python3 scripts/tenant.py status {{quote(profile)}} {{quote(tenant)}}

# Delete one tenant after confirming the exact profile/name pair.
tenant-delete profile tenant confirmation:
    @python3 scripts/tenant.py delete {{quote(profile)}} {{quote(tenant)}} {{quote(confirmation)}}

# Apply one local Tenant manifest through strict server-side validation.
local-tenant-apply manifest="config/tenants/examples/local.yaml":
    @python3 scripts/controller_tenant.py apply {{quote(manifest)}}

# Report one local Tenant from generation-aware Kubernetes conditions.
local-tenant-status tenant="tenant-example":
    @python3 scripts/controller_tenant_status.py {{quote(tenant)}}

# Delete one local Tenant through ordinary Kubernetes deletion and finalization.
local-tenant-delete tenant="tenant-example":
    @python3 scripts/controller_tenant.py delete {{quote(tenant)}}

# Generate Tenant CRD and RBAC artifacts from the locked Rust crate.
controller-generate:
    @python3 scripts/generate_controller.py

# Fetch locked Cargo dependencies into the repository-local Cargo home.
controller-fetch:
    @python3 scripts/fetch_controller.py

# Verify generated Tenant API artifacts are current.
controller-verify:
    @python3 scripts/generate_controller.py --verify

# Run Rust unit and integration tests from the locked Cargo cache.
controller-test:
    @python3 scripts/test_controller.py

# Check Rust format and Clippy warnings.
controller-lint:
    @python3 scripts/lint_controller.py

# Build the static Tenant controller manager binary.
controller-build:
    @python3 scripts/build_controller.py --binary

# Build the scratch Tenant controller image from verified assets.
controller-image:
    @python3 scripts/build_controller.py

# Exercise controller convergence through worker and host-resource creation.
