LAB_PREFIX=capi-kamaji-tenants
OWNERSHIP_LABEL=io.cnpg-vcluster.capi-lab
KIND_CLUSTER_NAME=capi-kamaji-management
MANAGEMENT_NAMESPACE=capi-kamaji-system
CAPI_NAMESPACE=capi-system
CABPK_NAMESPACE=capi-kubeadm-bootstrap-system
CAPD_NAMESPACE=capd-system
KAMAJI_CAPI_NAMESPACE=kamaji-system
MANAGEMENT_POD_CIDR=10.210.0.0/16
MANAGEMENT_SERVICE_CIDR=10.211.0.0/16
SPIKE_POD_CIDR=10.72.0.0/16
SPIKE_SERVICE_CIDR=10.142.0.0/16
SPIKE_DNS_SERVICE_IP=10.142.0.10
SPIKE_CLUSTER_DOMAIN=spike.capi.local
SPIKE_NAME=capi-worker-spike
SPIKE_NAMESPACE=capi-worker-spike
SPIKE_API_PORT=6443
SPIKE_STORAGE_CONTAINER_PATH=/var/lib/capi-tenant-storage
SPIKE_STORAGE_CLASS=capi-hostpath
SPIKE_CNPG_CLUSTER=capi-postgres
CNPG_NAMESPACE=cnpg-system
DATABASE_NAMESPACE=database
CNPG_TIMEOUT=1200s
SQL_TIMEOUT=300s
CNPG_COMPATIBILITY_REVISION=docker-volume-hostpath-v1
VIP_POOL_START_OFFSET_FROM_BROADCAST=32
VIP_POOL_END_OFFSET_FROM_BROADCAST=17
SPIKE_API_VIP_SLOT=2

MIN_DOCKER_CPUS=12
MIN_DOCKER_MEMORY_GIB=24
MIN_DOCKER_STORAGE_GIB=30
MIN_INOTIFY_INSTANCES=1024
MIN_INOTIFY_WATCHES=524288

DOWNLOAD_TIMEOUT=300s
COMMAND_TIMEOUT=900s
PREFLIGHT_PROBE_TIMEOUT=60s
KUBECTL_REQUEST_TIMEOUT=30s
CONDITION_TIMEOUT=900s
KIND_CREATE_TIMEOUT=300s
CERT_MANAGER_TIMEOUT=300s
METALLB_TIMEOUT=300s
KAMAJI_TIMEOUT=900s
PROVIDER_TIMEOUT=600s
DELETE_TIMEOUT=1200s
TENANT_CONTROL_PLANE_TIMEOUT=900s
WORKER_REGISTRATION_TIMEOUT=600s
WAIT_POLL_INTERVAL=5s
BOOTSTRAP_SECRET_RETENTION=86400s
BOOTSTRAP_SECRET_READER_SERVICE_ACCOUNTS="system:serviceaccount:capd-system:capd-manager system:serviceaccount:capi-kamaji-system:kamaji-controller-manager system:serviceaccount:capi-kubeadm-bootstrap-system:capi-kubeadm-bootstrap-manager system:serviceaccount:capi-system:capi-manager system:serviceaccount:cert-manager:cert-manager system:serviceaccount:cert-manager:cert-manager-cainjector system:serviceaccount:kamaji-system:capi-kamaji-controller-manager system:serviceaccount:kube-system:generic-garbage-collector system:serviceaccount:kube-system:namespace-controller system:serviceaccount:tenant-system:tenant-controller"

EXIT_SUCCESS=0
EXIT_ERROR=1
EXIT_BLOCKED=2
