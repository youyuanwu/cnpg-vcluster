  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "tenant-admin",
    "namespace": "tenant-system"
  },
  "spec": {
    "ports": [
      {
        "name": "http",
        "port": 80,
        "protocol": "TCP",
        "targetPort": 8080
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "tenant-admin"
    },
    "type": "ClusterIP"
  }
}
